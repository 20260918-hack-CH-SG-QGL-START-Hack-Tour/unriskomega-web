# Server-only upstream; no provider API keys belong in this service.
BACKEND_URL=http://localhost:8080
PORT=3000
HOSTNAME=0.0.0.0
NODE_ENV=production
WEB_PORT=3000
WEB_IMAGE_TAG=dev

# Optional local browser verification configuration (not needed in Azure).
QA_BASE_URL=http://localhost:3000
QA_OUTPUT_DIR=/tmp/unriskomega-web-qa
QA_PHASES=public,flow
# Leave unset to use the Chromium installed for Playwright.
# QA_CHROMIUM_PATH=/absolute/path/to/Chromium
